---
interface Props {
  value: string;
  label: string;
  description?: string;
}

const { value, label, description } = Astro.props;
---

<article class="metric-card">
  <div class="metric-value" aria-label={description || label}>
    {value}
  </div>
  <div class="metric-label">{label}</div>
</article>

<style>
  .metric-card {
    padding: 24px;
    border: 1px solid var(--color-black);
    background: var(--color-white);
    text-align: center;
  }

  .metric-value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
    color: var(--color-blue);
  }

  .metric-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .metric-card {
      padding: 16px;
    }

    .metric-value {
      font-size: 1.75rem;
    }
  }
</style>
