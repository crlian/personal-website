---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusColors: Record<string, string> = {
  live: '#16a34a',
  beta: '#ea580c',
  archived: '#737373',
  building: '#2563eb'
};

const statusLabel: Record<string, string> = {
  live: 'LIVE',
  beta: 'BETA',
  archived: 'ARCHIVED',
  building: 'BUILDING'
};

const roleLabel: Record<string, string> = {
  founder: 'FOUNDER',
  'co-founder': 'CO-FOUNDER',
  builder: 'BUILDER',
  'technical-lead': 'TECH LEAD'
};

// Get all tech stack items - prioritize primary techs
const primaryTechs = [
  ...(project.techStack.frontend || []).slice(0, 2),
  ...(project.techStack.backend || []).slice(0, 1),
  ...(project.techStack.database || []).slice(0, 1)
];

const stackDisplay = primaryTechs.slice(0, 4).join(' • ');

const allStackItems = [
  ...(project.techStack.frontend || []),
  ...(project.techStack.backend || []),
  ...(project.techStack.infrastructure || []),
  ...(project.techStack.database || [])
].filter(Boolean);

const stackLine = allStackItems.join(', ');

const highlightItems = [
  ...project.architecture.highlights,
  `Approach: ${project.architecture.approach}`,
  `Scalability: ${project.architecture.scalability}`,
  `Deployment: ${project.architecture.deployment}`
].filter(Boolean);

const keyLearnings = [
  ...project.learnings.business,
  ...project.learnings.technical
].filter(Boolean).slice(0, 3);
---

<details class="project-row-container">
  <summary class="project-row">
    <div class="row-expand">▸</div>
    <div class="row-title-group">
      <div class="row-title">{project.title}</div>
      {project.metrics.users && (
        <div class="row-metric">{project.metrics.users.toLocaleString()} users</div>
      )}
      {!project.metrics.users && project.metrics.revenue && (
        <div class="row-metric">{project.metrics.revenue}</div>
      )}
    </div>
    <div class="row-badges">
      <span class="row-badge status" style={`background-color: ${statusColors[project.status]}`}>
        {statusLabel[project.status]}
      </span>
      <span class="row-badge role">{roleLabel[project.role]}</span>
    </div>
    <div class="row-stack">{stackDisplay}</div>
  </summary>

  <div class="project-details">
    <!-- Problem & Solution -->
    <div class="details-section">
      <div class="section-grid">
        <div class="section-block">
          <h4 class="details-title">Problem</h4>
          <p class="details-text">{project.problem}</p>
        </div>
        <div class="section-block">
          <h4 class="details-title">Solution</h4>
          <p class="details-text">{project.solution}</p>
        </div>
      </div>
    </div>

    <!-- Highlights -->
    <div class="details-section">
      <h4 class="details-title">Highlights</h4>
      {highlightItems.length > 0 && (
        <ul class="highlights-list">
          {highlightItems.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      )}
    </div>

    <!-- Metrics & Timeline -->
    <div class="details-section">
      <div class="metrics-timeline-grid">
        <div class="metrics-block">
          <h4 class="details-title">Metrics</h4>
          <div class="metrics-list">
            {project.metrics.users && (
              <div class="metric-item">
                <span class="metric-label">Users:</span>
                <span class="metric-value">{project.metrics.users.toLocaleString()}</span>
              </div>
            )}
            {project.metrics.revenue && (
              <div class="metric-item">
                <span class="metric-label">Revenue:</span>
                <span class="metric-value">{project.metrics.revenue}</span>
              </div>
            )}
            {project.metrics.growth && (
              <div class="metric-item">
                <span class="metric-label">Growth:</span>
                <span class="metric-value">{project.metrics.growth}</span>
              </div>
            )}
            {project.metrics.performance && (
              <div class="metric-item">
                <span class="metric-label">Performance:</span>
                <span class="metric-value">{project.metrics.performance}</span>
              </div>
            )}
          </div>
        </div>

        <div class="timeline-block">
          <h4 class="details-title">Timeline</h4>
          <div class="timeline-list">
            <div class="timeline-item">
              <span class="timeline-label">Total:</span>
              <span class="timeline-value">{project.timeline.totalDuration}</span>
            </div>
            <div class="timeline-item">
              <span class="timeline-label">Launched:</span>
              <span class="timeline-value">{new Date(project.timeline.launchDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Learnings -->
    {keyLearnings.length > 0 && (
      <div class="details-section">
        <h4 class="details-title">Key Learnings</h4>
        <ul class="learning-list">
          {keyLearnings.map((learning) => (
            <li>{learning}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Stack -->
    {stackLine && (
      <div class="details-section">
        <div class="stack-line">
          <span class="stack-line-label">Stack:</span>
          <span class="stack-line-value">{stackLine}</span>
        </div>
      </div>
    )}

    <!-- Links -->
    {(project.demoUrl || project.githubUrl) && (
      <div class="details-links">
        {project.demoUrl && (
          <a href={project.demoUrl} class="details-link" target="_blank" rel="noopener noreferrer">
            View Live Demo →
          </a>
        )}
        {project.githubUrl && (
          <a href={project.githubUrl} class="details-link" target="_blank" rel="noopener noreferrer">
            View on GitHub →
          </a>
        )}
      </div>
    )}
  </div>
</details>

<style>
  .project-row-container {
    border: 1px solid var(--color-black);
    margin-bottom: 0.5rem;
  }

  .project-row-container[open] .project-row {
    border-bottom: 1px solid var(--color-black);
  }

  .project-row-container[open] .row-expand {
    transform: rotate(90deg);
  }

  /* Row Summary */
  .project-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    background-color: var(--color-white);
    transition: background-color 0.2s ease;
  }

  .project-row:hover {
    background-color: #f9f9f9;
  }

  .project-row::-webkit-details-marker {
    display: none;
  }

  .row-expand {
    flex-shrink: 0;
    width: 20px;
    font-weight: bold;
    transition: transform 0.2s ease;
    color: var(--color-blue);
  }

  .row-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-grow: 0;
    min-width: 150px;
  }

  .row-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .row-metric {
    font-size: 0.75rem;
    color: #666;
    font-weight: 500;
    white-space: nowrap;
  }

  .row-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .row-badge {
    display: inline-block;
    padding: 0.3rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid;
  }

  .row-badge.status {
    color: var(--color-white);
    border-color: currentColor;
  }

  .row-badge.role {
    border-color: var(--color-black);
    color: var(--color-black);
  }

  .row-stack {
    flex: 1;
    font-size: 0.8rem;
    color: #666;
    font-family: 'Monaco', 'Courier New', monospace;
    text-align: right;
  }

  /* Details Section */
  .project-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
    background-color: #fafafa;
    border-top: 1px solid #eee;
  }

  .details-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .details-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-black);
    margin: 0;
  }

  .details-text {
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
    color: #444;
  }

  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .section-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .highlights-list li {
    font-size: 0.85rem;
    padding-left: 1rem;
    position: relative;
    color: #444;
  }

  .highlights-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-blue);
    font-weight: bold;
    font-size: 0.75rem;
  }

  /* Metrics & Timeline */
  .metrics-timeline-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .metrics-block,
  .timeline-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .metrics-list,
  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-item,
  .timeline-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem;
    background-color: var(--color-white);
    border: 1px solid #ddd;
    font-size: 0.85rem;
  }

  .metric-label,
  .timeline-label {
    font-weight: 600;
    color: #666;
  }

  .metric-value,
  .timeline-value {
    font-weight: 700;
    color: var(--color-black);
  }

  /* Learnings */
  .learning-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .learning-list li {
    font-size: 0.85rem;
    padding-left: 1rem;
    position: relative;
    color: #444;
    line-height: 1.4;
  }

  .learning-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-blue);
  }

  .stack-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #444;
    line-height: 1.5;
  }

  .stack-line-label {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #666;
  }

  .stack-line-value {
    font-family: 'Monaco', 'Courier New', monospace;
  }

  /* Links */
  .details-links {
    display: flex;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid #ddd;
    flex-wrap: wrap;
  }

  .details-link {
    display: inline-block;
    border: 1px solid var(--color-black);
    padding: 0.6rem 1rem;
    text-decoration: none;
    color: var(--color-black);
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .details-link:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .row-stack {
      display: none;
    }

    .metrics-timeline-grid {
      grid-template-columns: 1fr;
    }

    .section-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .project-row {
      gap: 0.75rem;
      padding: 0.75rem;
    }

    .row-title-group {
      min-width: auto;
      flex: 1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .row-badges {
      flex-direction: column;
      gap: 0.25rem;
    }

    .project-details {
      padding: 1rem;
    }

    .details-links {
      flex-direction: column;
    }

    .details-link {
      width: 100%;
      text-align: center;
    }
  }
</style>
