---
interface Props {
  id: string;
  title: string;
  description: string;
  tags: string[];
  imageUrl?: string;
  link: string;
}

const { title, description, tags, imageUrl, link } = Astro.props;
---

<article class="project-card">
  <div class="project-image">
    {imageUrl ? (
      <img src={imageUrl} alt={`Captura de pantalla de ${title}`} loading="lazy" />
    ) : (
      <div class="placeholder" aria-label="Imagen de proyecto pendiente"></div>
    )}
  </div>

  <div class="project-content">
    <h3>{title}</h3>
    <p>{description}</p>

    <ul class="tags" role="list">
      {tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>

    <a href={link} class="btn" aria-label={`Ver detalles de ${title}`}>
      Ver <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-black);
    background: var(--color-white);
  }

  .project-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-black);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: #999;
  }

  .project-content {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .project-content p {
    margin: 0;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tag {
    padding: 4px 8px;
    background: var(--color-white);
    border: 1px solid var(--color-black);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .btn {
    align-self: flex-start;
    margin-top: auto;
  }
</style>
