---
import Layout from '../layouts/Layout.astro';
import BuilderHero from '../components/BuilderHero.astro';
import BuildingNow from '../components/BuildingNow.astro';
import ShippingMetric from '../components/ShippingMetric.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects, currentlyBuilding, shippingMetrics } from '../data/portfolio';

// Separate projects by status - show live/beta first, then archived
const activeProjects = projects.filter((p) => p.status === 'live' || p.status === 'beta');
const archivedProjects = projects.filter((p) => p.status === 'archived');
const buildingProjects = projects.filter((p) => p.status === 'building');
const allOrderedProjects = [...activeProjects, ...buildingProjects, ...archivedProjects];
---

<Layout title="Cesar Rico - Builder / Founder">
  <div class="container">
    <!-- Hero Section -->
    <BuilderHero />

    <!-- Shipping Metrics Section -->
    <section class="section metrics-section" aria-labelledby="shipping-heading">
      <h2 id="shipping-heading" class="section-heading">Track Record</h2>

      <div class="shipping-metrics-grid">
        {shippingMetrics.map((metric) => (
          <ShippingMetric metric={metric} />
        ))}
      </div>
    </section>

    <!-- Projects Section - Compact Rows with Expandable Details -->
    <section id="track-record" class="section projects-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="section-heading">Shipped Products</h2>

      <div class="projects-rows">
        {allOrderedProjects.map((project) => (
          <ProjectRow project={project} />
        ))}
      </div>
    </section>

    <!-- Building Now Section -->
    <section id="building" class="section building-section">
      <h2 class="section-heading">Currently Building</h2>
      <BuildingNow project={currentlyBuilding} />
    </section>

    <!-- Footer CTA -->
    <footer class="footer" id="contact">
      <div class="footer-content">
        <h2 class="footer-heading">Need some help?</h2>
        <p class="footer-description">
          I enjoy working with product-first teams that care about shipping.
          Just contact me when you need another set of hands.
        </p>

        <div class="footer-availability">
          <span class="availability-indicator"></span>
          <span class="availability-text">Available for new projects</span>
        </div>

        <a href="mailto:cesarrico16@gmail.com" class="footer-cta">Start a conversation →</a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* Layout */
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 2rem 0;
    border-bottom: 2px solid var(--color-black);
    padding-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.1rem;
  }

  /* Building Section */
  .building-section {
    margin-bottom: 4rem;
  }

  /* Shipping Metrics Section */
  .metrics-section {
    border-top: 1px solid var(--color-black);
    padding-top: 2rem;
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }

  .shipping-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  /* Projects Section */
  .projects-section {
    margin-bottom: 3rem;
  }

  .projects-rows {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-black);
  }

  .projects-rows > :not(:last-child) {
    border-bottom: 1px solid var(--color-black);
  }

  /* Footer */
  .footer {
    margin-top: 4rem;
    border-top: 2px solid var(--color-black);
    padding-top: 3rem;
    text-align: center;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-heading {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .footer-description {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    color: #444;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .footer-availability {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .availability-indicator {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .availability-text {
    color: var(--color-black);
  }

  .footer-cta {
    display: inline-block;
    border: 2px solid var(--color-black);
    padding: 1rem 2rem;
    background-color: var(--color-black);
    color: var(--color-white);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.2s ease;
    margin-top: 1rem;
  }

  .footer-cta:hover {
    background-color: var(--color-white);
    color: var(--color-black);
  }

  /* Accessibility */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .container {
      padding: 1rem;
    }

    .section {
      margin-bottom: 2rem;
    }

    .section-heading {
      font-size: 1rem;
    }

    .shipping-metrics-grid {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 0.75rem;
    }

    .footer-heading {
      font-size: 1.4rem;
    }

    .footer-cta {
      width: 100%;
      text-align: center;
    }
  }
</style>
